{
  "name": "dsh-ai-girl-theme",
  "version": "1.1.0",
  "description": "AI girl theme for DeepSeek Harness: per-model gijinka wallpapers, a pixel typeface, and a per-provider picker in the model settings.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "theme",
    "wallpaper",
    "ai-girl",
    "gijinka",
    "anime"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhouribin/dsh-ai-girl-theme.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "wallpapers/**/*.webp",
    "docs/preview.webp",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "LICENSE-ART.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  }
}
